index="idx_oscar_events" status=dismissed
| dedup id
| spath path=fileStates{}.name output=file_names
| makemv files
| foreach mode=multivalue itemstr=<<Name>> iterstr=<<Iter>> file_names
[ eval path=json_extract(_raw, "fileStates{<<Iter>>}.path"),
         file=if(isnull(path), <<Name>>, path."\\".<<Name>>),
         files=mvappend(files, file) ]
| eval @hostname=upper(mvdedup('hostStates{}.fqdn'))
