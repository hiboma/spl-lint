index="idx_charlie_events"
| search "connected from"
| rex field=_raw "user id '(?<email>.*)'\s+local ip\s+(?<local_ip>\d{1,3}(?:\.\d{1,3}){3})\s+connected from\s+(?<src_ip>\d{1,3}(?:\.\d{1,3}){3})"
| iplocation src_ip
| search Country != "Japan"
| eval @email=email
| table @email, _time, src_ip, local_ip, Country, City
