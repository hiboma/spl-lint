index="idx_november" source="jamf://Computers"
| dedup computer.general.id
| eval a_week_ago = relative_time(now(), "-1w@w")
| rename computer.general.last_contact_time as last_contact_time
| rename computer.general.name as hostname
| eval last_contact_time_unix = strptime(last_contact_time,"%Y-%m-%d %H:%M:%S")
| lookup host-lookup.csv hostname OUTPUT hostname
| where last_contact_time_unix < a_week_ago
| where hostname != ""
| stats count
